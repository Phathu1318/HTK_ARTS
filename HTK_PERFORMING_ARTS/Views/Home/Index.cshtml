@{
    ViewData["Title"] = "Home";
}

<!--  HERO SECTION -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center min-vh-75">

            <!-- Hero Content -->
            <div class="col-lg-6">

                <span class="hero-badge">
                    <i class="bi bi-stars"></i>
                    HTK Performing Arts Institute
                </span>

                <h1>
                    Discover Your
                    <span>Creative Potential.</span>
                </h1>

                <p class="hero-text">
                    Develop your talent, confidence and creativity through
                    professional training in modelling, acting, dancing,
                    music and poetry.
                </p>

                <div class="hero-buttons">

                    <a href="#register"
                       class="btn btn-htk btn-lg">

                        Register Now

                        <i class="bi bi-arrow-right"></i>

                    </a>

                    <a href="#programmes"
                       class="btn btn-outline-light btn-lg">

                        Explore Programmes

                    </a>

                </div>


                <!-- Class Information -->

                <div class="hero-info">

                    <div>

                        <i class="bi bi-calendar-event"></i>

                        <span>

                            <strong>Every Saturday</strong>

                            <small>
                                09:00 - 16:00
                            </small>

                        </span>

                    </div>


                    <div>

                        <i class="bi bi-people-fill"></i>

                        <span>

                            <strong>Primary & High School</strong>

                            <small>
                                Learners welcome
                            </small>

                        </span>

                    </div>

                </div>

            </div>


            <!-- Hero Image -->

            <div class="col-lg-6 mt-5 mt-lg-0">

                <div class="hero-image-wrapper">

                    <div class="hero-image-decoration"></div>

                    <img src="~/images/htk-programmes.jpg"
                         alt="HTK Performing Arts learners"
                         class="hero-image" />


                    <!-- Floating Card -->

                    <div class="hero-floating-card">

                        <i class="bi bi-award-fill"></i>

                        <div>

                            <strong>
                                Grow Your Talent
                            </strong>

                            <small>
                                Learn • Create • Perform
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- WELCOME SECTION -->

<section class="intro-section">

    <div class="container">

        <div class="row justify-content-center text-center">

            <div class="col-lg-8">

                <span class="section-label">
                    WELCOME TO HTK
                </span>

                <h2>
                    Where Talent Meets
                    <span>Opportunity</span>
                </h2>

                <p>
                    HTK Performing Arts Institute is a performance enhancement
                    organisation that provides both theory and practical
                    training for school learners following the South African
                    school curriculum.
                </p>

            </div>

        </div>


        <!-- Information Cards -->

        <div class="row g-4 mt-4">

            <!-- Theory -->

            <div class="col-md-4">

                <div class="info-card">

                    <div class="icon-circle">

                        <i class="bi bi-book-fill"></i>

                    </div>

                    <h4>
                        Theory & Knowledge
                    </h4>

                    <p>
                        Learn the foundations and principles behind the
                        performing arts through structured training.
                    </p>

                </div>

            </div>


            <!-- Practical -->

            <div class="col-md-4">

                <div class="info-card">

                    <div class="icon-circle">

                        <i class="bi bi-person-video3"></i>

                    </div>

                    <h4>
                        Practical Training
                    </h4>

                    <p>
                        Put your knowledge into practice through hands-on
                        performing arts activities.
                    </p>

                </div>

            </div>


            <!-- Talent -->

            <div class="col-md-4">

                <div class="info-card">

                    <div class="icon-circle">

                        <i class="bi bi-stars"></i>

                    </div>

                    <h4>
                        Develop Your Talent
                    </h4>

                    <p>
                        Build confidence, creativity and performance skills
                        in a supportive environment.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- ABOUT SECTION -->

<section id="about"
         class="about-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Image -->

            <div class="col-lg-6">

                <div class="about-image-wrapper">

                    <img src="~/images/htk-programmes.jpg"
                         alt="HTK Performing Arts training"
                         class="about-image" />

                </div>

            </div>


            <!-- Content -->

            <div class="col-lg-6">

                <span class="section-label">
                    ABOUT US
                </span>

                <h2>
                    Building Confidence Through
                    <span>Performing Arts</span>
                </h2>

                <p>
                    At HTK Performing Arts Institute, we believe that every
                    learner has the potential to express themselves,
                    discover their abilities and grow through the performing
                    arts.
                </p>

                <p>
                    Our training combines theory and practical activities,
                    giving learners the opportunity to develop their
                    creativity, confidence, discipline and performance skills.
                </p>


                <!-- About Features -->

                <div class="about-list">

                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Theory and practical training

                    </div>

                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Primary and high school learners

                    </div>

                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Multiple performing arts disciplines

                    </div>

                    <div>

                        <i class="bi bi-check-circle-fill"></i>

                        Saturday classes from 09:00 - 16:00

                    </div>

                </div>


                <a href="#programmes"
                   class="btn btn-dark-purple mt-3">

                    Discover Our Programmes

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>



<!-- PROGRAMMES SECTION -->

<section id="programmes"
         class="programmes-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
                WHAT WE OFFER
            </span>

            <h2>
                Explore Our
                <span>Programmes</span>
            </h2>

            <p>
                Choose from a range of performing arts disciplines designed
                to help young learners express themselves and develop their
                skills.
            </p>

        </div>


        <div class="row g-4 mt-4">

            <!-- Modelling -->

            <div class="col-sm-6 col-lg-4">

                <div class="programme-card">

                    <div class="programme-icon">

                        <i class="bi bi-person-standing"></i>

                    </div>

                    <h4>
                        Modelling
                    </h4>

                    <p>
                        Develop confidence, presentation skills, stage
                        presence and professional modelling techniques.
                    </p>

                    <a href="#register">

                        Learn More

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- Acting -->

            <div class="col-sm-6 col-lg-4">

                <div class="programme-card">

                    <div class="programme-icon">

                        <i class="bi bi-mask"></i>

                    </div>

                    <h4>
                        Acting
                    </h4>

                    <p>
                        Explore character development, expression,
                        storytelling and performance.
                    </p>

                    <a href="#register">

                        Learn More

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- Dancing -->

            <div class="col-sm-6 col-lg-4">

                <div class="programme-card">

                    <div class="programme-icon">

                        <i class="bi bi-music-note-beamed"></i>

                    </div>

                    <h4>
                        Dancing
                    </h4>

                    <p>
                        Improve movement, coordination, rhythm and stage
                        performance through dance.
                    </p>

                    <a href="#register">

                        Learn More

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- Music -->

            <div class="col-sm-6 col-lg-4">

                <div class="programme-card">

                    <div class="programme-icon">

                        <i class="bi bi-mic-fill"></i>

                    </div>

                    <h4>
                        Music
                    </h4>

                    <p>
                        Explore musical expression, performance and the
                        fundamentals of music.
                    </p>

                    <a href="#register">

                        Learn More

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- Poetry -->

            <div class="col-sm-6 col-lg-4">

                <div class="programme-card">

                    <div class="programme-icon">

                        <i class="bi bi-feather"></i>

                    </div>

                    <h4>
                        Poetry
                    </h4>

                    <p>
                        Develop creative writing, expression, confidence and
                        performance through poetry.
                    </p>

                    <a href="#register">

                        Learn More

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- Performance -->

            <div class="col-sm-6 col-lg-4">

                <div class="programme-card programme-card-highlight">

                    <div class="programme-icon">

                        <i class="bi bi-stars"></i>

                    </div>

                    <h4>
                        Perform & Grow
                    </h4>

                    <p>
                        Bring your skills together and gain confidence through
                        performance opportunities.
                    </p>

                    <a href="#register">

                        Register Now

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- WHY HTK SECTION -->

<section id="why-us"
         class="why-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="section-label">
                    WHY CHOOSE HTK?
                </span>

                <h2>
                    More Than Just
                    <span>Training</span>
                </h2>

                <p>
                    Our goal is to create an environment where young people
                    can learn, express themselves and become confident
                    performers.
                </p>

            </div>


            <div class="col-lg-6">

                <div class="why-grid">

                    <!-- Creativity -->

                    <div class="why-item">

                        <i class="bi bi-lightbulb-fill"></i>

                        <div>

                            <h5>
                                Creativity
                            </h5>

                            <p>
                                Encourage creative thinking and expression.
                            </p>

                        </div>

                    </div>


                    <!-- Confidence -->

                    <div class="why-item">

                        <i class="bi bi-person-check-fill"></i>

                        <div>

                            <h5>
                                Confidence
                            </h5>

                            <p>
                                Help learners become confident performers.
                            </p>

                        </div>

                    </div>


                    <!-- Teamwork -->

                    <div class="why-item">

                        <i class="bi bi-people-fill"></i>

                        <div>

                            <h5>
                                Teamwork
                            </h5>

                            <p>
                                Learn how to work and perform together.
                            </p>

                        </div>

                    </div>


                    <!-- Growth -->

                    <div class="why-item">

                        <i class="bi bi-trophy-fill"></i>

                        <div>

                            <h5>
                                Growth
                            </h5>

                            <p>
                                Develop skills for future opportunities.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- REGISTRATION CTA -->

<section id="register"
         class="register-section">

    <div class="container">

        <div class="register-content text-center">

            <span class="section-label light">
                START YOUR JOURNEY
            </span>

            <h2>
                Ready to Discover
                <span>Your Talent?</span>
            </h2>

            <p>
                Give your child the opportunity to learn, perform and grow
                through the performing arts.
            </p>

            <a href="#contact"
               class="btn btn-light btn-lg">

                Register Your Child

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</section>