<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HTK Performing Arts Institute</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HTK_PERFORMING_ARTS.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- NAVIGATION BAR -->
    <header>

        <nav class="navbar navbar-expand-lg htk-navbar">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/htk-logo.png"
                         alt="HTK Performing Arts Institute Logo"
                         class="htk-logo" />

                </a>


                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation Links -->
                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link active"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Home/Index#about">

                                About Us

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Home/Index#programmes">

                                Programmes

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Home/Index#why-us">

                                Why HTK

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Home/Index#contact">

                                Contact

                            </a>

                        </li>


                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">

                            <a class="btn btn-htk"
                               href="/Home/Index#register">

                                Register Now

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- MAIN CONTENT -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- FOOTER -->

    <footer class="htk-footer">

        <div class="container">

            <div class="row g-4">

                <!-- About HTK -->
                <div class="col-lg-4 col-md-6">

                    <img src="~/images/htk-logo.png"
                         alt="HTK Performing Arts Institute"
                         class="footer-logo mb-3" />

                    <p>
                        HTK Performing Arts Institute is a performance
                        enhancement organisation providing theory and
                        practical training for school learners.
                    </p>

                    <p class="footer-location">

                        <i class="bi bi-geo-alt-fill"></i>

                        Zone Fitness Gym, Pretoria Central

                    </p>

                </div>


                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">

                    <h5>Quick Links</h5>

                    <ul class="footer-links">

                        <li>
                            <a href="/Home/Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a href="/Home/Index#about">
                                About Us
                            </a>
                        </li>

                        <li>
                            <a href="/Home/Index#programmes">
                                Programmes
                            </a>
                        </li>

                        <li>
                            <a href="/Home/Index#contact">
                                Contact
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- Programmes -->
                <div class="col-lg-3 col-md-6">

                    <h5>Our Programmes</h5>

                    <ul class="footer-links">

                        <li>
                            <i class="bi bi-chevron-right"></i>
                            Modelling
                        </li>

                        <li>
                            <i class="bi bi-chevron-right"></i>
                            Acting
                        </li>

                        <li>
                            <i class="bi bi-chevron-right"></i>
                            Dancing
                        </li>

                        <li>
                            <i class="bi bi-chevron-right"></i>
                            Music
                        </li>

                        <li>
                            <i class="bi bi-chevron-right"></i>
                            Poetry
                        </li>

                    </ul>

                </div>


                <!-- Contact -->
                <div class="col-lg-3 col-md-6"
                     id="contact">

                    <h5>Contact Us</h5>

                    <p>

                        <i class="bi bi-whatsapp"></i>

                        072 023 6751

                    </p>

                    <p>

                        <i class="bi bi-telephone-fill"></i>

                        063 310 4966

                    </p>

                    <p>

                        <i class="bi bi-envelope-fill"></i>

                        info.htkarts@gmail.com

                    </p>


                    <!-- Social Media -->

                    <div class="social-links">

                        <a href="#"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>

                        <a href="#"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>

                        <a href="#"
                           aria-label="TikTok">

                            <i class="bi bi-tiktok"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- Footer Divider -->

            <hr />


            <!-- Bottom Footer -->

            <div class="footer-bottom">

                <p class="mb-0">

                    &copy; @DateTime.Now.Year
                    HTK Performing Arts Institute.
                    All Rights Reserved.

                </p>

                <p class="mb-0">

                    Learn
                    <span>•</span>
                    Create
                    <span>•</span>
                    Perform

                </p>

            </div>

        </div>

    </footer>


    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
